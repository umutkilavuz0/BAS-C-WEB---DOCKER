datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  todos     Todo[]   @relation("UserTodos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshToken String?  // Refresh token saklamak için
}

model Todo {
  id          String   @id @default(uuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  category    String   @default("Genel") // Örn: İşi, Hedef, Kişisel vs.
  dueDate     DateTime?
  userId      String
  user        User     @relation("UserTodos", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}